{
  "name": "alloy-di",
  "version": "1.5.0",
  "description": "A build-time dependency injection plugin for Vite",
  "keywords": [
    "dependency-injection",
    "di",
    "typescript",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://alloy-di.dev",
  "license": "MIT",
  "author": "Mikael Selander",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciddan/alloy-di/tree/main/packages/alloy"
  },
  "bin": {
    "alloy": "./bin/alloy.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./scopes": {
      "types": "./dist/scopes.d.ts",
      "import": "./dist/scopes.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix --type-aware --config ./.oxlintrc.json .",
    "lint:check": "oxlint --type-aware --config ./.oxlintrc.json .",
    "test": "vitest --run",
    "test:cover": "vitest --run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b . --noEmit"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "rimraf": "^6.1.3",
    "rolldown": "1.1.0",
    "rolldown-plugin-dts": "^0.25.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vitest": ">=4.0.14 <5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
